x-common-environment-variables: &wordpress_variables
      WORDPRESS_DB_HOST: {{ db_host }}
      WORDPRESS_DB_NAME: {{ db_name }}
      WORDPRESS_DB_USER: {{ db_user }}
      WORDPRESS_DB_PASSWORD: {{ db_password }}
      WORDPRESS_DEBUG: 1

services:
  nginx:
    image: nginx:1.30.6-alpine3.24
    restart: always
    ports:
     - 0.0.0.0:443:443
    volumes:
     - wordpress:/var/www/html
     - php_my_admin:/var/www/php_my_admin
     - ./certificate.key:/var/certificate.key
     - ./certificate.pem:/var/certificate.pem
     - ./containers_configs/wordpress_nginx.conf:/etc/nginx/conf.d/default.conf


  phpmyadmin:
    image: phpmyadmin:5.2.3-fpm-alpine
    restart: always
    environment:
      PMA_SSL: 1
      PMA_HOST: db
      MYSQL_ROOT_PASSWORD: {{ db_root_password }}
    depends_on:
      db:
        condition: service_healthy
    volumes:
     - php_my_admin:/var/www/html
     - ./containers_configs/docker.conf:/usr/local/etc/php-fpm.d/docker.conf

  db:
    image: mariadb:13.0.2
    restart: always
    environment:
      MARIADB_DATABASE: {{ db_name }}
      MARIADB_USER: {{ db_user }}
      MARIADB_PASSWORD: {{ db_password }}
      MARIADB_ROOT_PASSWORD: {{ db_root_password }}
    volumes:
      - db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3

  wordpress_php_fpm:
    image: wordpress:php8.4-fpm-alpine
    restart: always
    environment:
      <<: [*wordpress_variables]
    volumes:
      - wordpress:/var/www/html
      - ./containers_configs/docker.conf:/usr/local/etc/php-fpm.d/docker.conf
    depends_on:
      db:
        condition: service_healthy

  wp_cli:
    image: wordpress:cli-php8.5
    environment:
      <<: [*wordpress_variables]
      NOME_MAE: neide
    volumes:
      - wordpress:/var/www/html
    depends_on:
      db:
        condition: service_healthy

volumes:
  wordpress:
  db:
  php_my_admin:
    
